{
  "name": "code-rendered-video-starter",
  "type": "module",
  "private": true,
  "scripts": {
    "studio": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "render": "bun scripts/render.ts",
    "single": "bun scripts/build-single.ts",
    "make-grid": "bun scripts/make-click-grid.ts",
    "shots": "bun scripts/python.ts scripts/build-shot-files.py",
    "score": "bun scripts/make-score.ts",
    "voice:sapi": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/voice-sapi.ps1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/opentype.js": "^1.3.10",
    "@types/three": "^0.186.0",
    "playwright-core": "^1.63.0",
    "vite": "^8.3.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "opentype.js": "^2.0.0",
    "three": "^0.186.0"
  }
}
